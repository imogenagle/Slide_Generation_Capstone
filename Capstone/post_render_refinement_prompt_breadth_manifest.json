      "prompt_family": "add_bullet",
      "active_slide_id": "S05",
      "target_slide_ids": ["S05"],
      "instruction": "Add one clear takeaway bullet to slide 5. Keep the existing claim and do not change other slides.",
      "edit_tasks": [
        {
          "task_id": "T01",
          "slide_id": "S05",
          "operation": "add_bullet",
          "requirement": "Add exactly one new top-level bullet to S05."
        }
      ],
      "constraints": {
        "max_changed_slides": 1,
        "preserve_paper_fidelity": true,
        "do_not_introduce_external_assets": true
