{
  "description": "Prompt-breadth post-render refinement evaluation: 10 realistic user request patterns across five representative generated decks.",
  "case_templates": [
    {
      "case_id": "bundled_title_bullet_audience",
      "prompt_family": "bundled_multi_edit",
      "active_slide_id": "S02",
      "target_slide_ids": ["S02", "S03", "S04", "S05"],
      "instruction": "Make the title more direct, add another bullet to slide 5, and make slides 3 and 4 better for a general technical audience.",
      "edit_tasks": [
        {
          "task_id": "T01",
          "slide_id": "S02",
          "operation": "rewrite_title",
          "requirement": "Make the visible slide title more direct. This resolves the unscoped title request against active_slide_id S02."
        },
        {
          "task_id": "T02",
          "slide_id": "S05",
          "operation": "add_bullet",
          "requirement": "Add exactly one new top-level bullet while preserving the slide's existing purpose."
        },
        {
          "task_id": "T03",
          "slide_id": "S03",
          "operation": "audience_rewrite",
          "requirement": "Rewrite slide content for a general technical audience while preserving paper fidelity."
        },
        {
          "task_id": "T04",
          "slide_id": "S04",
          "operation": "audience_rewrite",
          "requirement": "Rewrite slide content for a general technical audience while preserving paper fidelity."
        }
      ],
      "constraints": {
        "max_changed_slides": 4,
        "allow_slide_splits": false,
        "allow_slide_merges": false,
        "preserve_section_order": true,
        "preserve_paper_fidelity": true,
        "do_not_introduce_external_assets": true
      },
      "expected": {
        "target_slide_changed": true,
        "all_target_slides_changed": true,
        "only_target_slides_changed": true,
        "protected_slides_unchanged": true,
        "title_changed_slide_id": "S02",
        "pptx_specified_title_visible": true,
        "bullet_count_delta_by_slide": {
          "S05": 1
        },
        "no_external_asset_changes": true
      }
    },
    {
      "case_id": "title_direct_active_slide",
      "prompt_family": "title_rewrite",
      "active_slide_id": "S02",
      "target_slide_ids": ["S02"],
      "instruction": "Make the title on this slide more direct and presentation-ready without changing the rest of the deck.",
      "edit_tasks": [
        {
          "task_id": "T01",
          "slide_id": "S02",
          "operation": "rewrite_title",
          "requirement": "Rewrite the visible slide title in subsection to be more direct."
        }
      ],
      "constraints": {
        "max_changed_slides": 1,
        "preserve_paper_fidelity": true,
        "do_not_introduce_external_assets": true
      },
      "expected": {
        "target_slide_changed": true,
        "only_target_slide_changed": true,
        "title_changed": true,
        "pptx_target_title_visible": true,
        "protected_slides_unchanged": true,
        "no_external_asset_changes": true
      }
    },
    {
